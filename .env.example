# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL.
# Found at: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL="https://your-project-ref.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Server-side service role key (keep secret!).
# Found at: Supabase Dashboard → Project Settings → API → service_role key
# WARNING: Never expose this key in the frontend / client-side code.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# VITE_API_BASE_URL (Optional): Used by the frontend if hosted separately (e.g., on Vercel).
# Set this to your Render backend URL (e.g. https://your-aletiq-backend.onrender.com).
# Leave blank or omit for local development.
VITE_API_BASE_URL=""

# =============================================================================
# INSPECTOR AUTHENTICATION & CLOUDFLARE TURNSTILE CAPTCHA
# =============================================================================

# VITE_TURNSTILE_SITE_KEY: Cloudflare Turnstile public site key (safe for client-side).
# For production: Obtain from Cloudflare Dashboard -> Turnstile -> Sites -> Site Key
# For development/testing: '1x00000000000000000000AA' (Always Passes test key)
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# TURNSTILE_SECRET_KEY: Cloudflare Turnstile backend secret key (NEVER expose to frontend!).
# For production: Obtain from Cloudflare Dashboard -> Turnstile -> Sites -> Secret Key
# For development/testing: '1x0000000000000000000000000000000AA' (Always Passes test secret)
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# JWT_SECRET: Strong secret key for signing HMAC-SHA256 Inspector session JWTs (backend only).
JWT_SECRET="your-jwt-secret-key-min-32-chars"
